{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "required": ["data", "meta"],
  "properties": {
    "data": {
      "type": "object",
      "required": ["message"],
      "properties": {
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "meta": { "$ref": "auth-meta.schema.json" }
  }
}
